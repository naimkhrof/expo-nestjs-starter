{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [
    ".env",
    "apps/*/.env",
    "apps/*/.env.*"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "EXPO_PUBLIC_*",
        "APP_BUILD_ONLY_VAR",
        "EAS_PROJECT_ID"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "*.tsbuildinfo"
      ],
      "env": [
        "EXPO_PUBLIC_*",
        "APP_BUILD_ONLY_VAR",
        "EAS_PROJECT_ID"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": []
    },
    "test": {
      "outputs": []
    }
  }
}
