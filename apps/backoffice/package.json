{
  "name": "@starter/backoffice",
  "version": "0.1.0",
  "private": true,
  "description": "Back-office : Expo web seul, ouvert par un compte administrateur de l'API.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port ${BACKOFFICE_PORT:-8090}",
    "build": "expo export --platform web --output-dir dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src metro.config.js",
    "test": "jest --runInBand --watchman=false",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.16",
    "@starter/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.19",
    "axios": "^1.13.2",
    "expo": "~58.0.22",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "uniwind": "^1.13.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.2",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.13",
    "tailwindcss": "4.1.18",
    "typescript": "^6.0.3",
    "wrangler": "4.85.0"
  }
}
