{
  "name": "@starter/api",
  "version": "0.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typeorm": "env-cmd -- typeorm-ts-node-commonjs",
    "migration:generate": "pnpm run typeorm --dataSource=src/database/data-source.ts migration:generate",
    "postmigration:generate": "pnpm run lint --fix",
    "migration:create": "pnpm run typeorm migration:create",
    "migration:run": "pnpm run typeorm --dataSource=src/database/data-source.ts migration:run",
    "migration:revert": "pnpm run typeorm --dataSource=src/database/data-source.ts migration:revert",
    "schema:drop": "pnpm run typeorm --dataSource=src/database/data-source.ts schema:drop",
    "seed:create:relational": "hygen seeds create-relational",
    "postseed:create:relational": "pnpm run lint --fix",
    "seed:create:document": "hygen seeds create-document",
    "postseed:create:document": "pnpm run lint --fix",
    "generate:resource:relational": "hygen generate relational-resource",
    "postgenerate:resource:relational": "pnpm run lint --fix",
    "generate:resource:document": "hygen generate document-resource",
    "postgenerate:resource:document": "pnpm run lint --fix",
    "generate:resource:all-db": "hygen generate all-db-resource",
    "postgenerate:resource:all-db": "pnpm run lint --fix",
    "add:property:to-all-db": "hygen property add-to-all-db",
    "postadd:property:to-all-db": "pnpm run lint --fix",
    "add:property:to-document": "hygen property add-to-document",
    "postadd:property:to-document": "pnpm run lint --fix",
    "add:property:to-relational": "hygen property add-to-relational",
    "postadd:property:to-relational": "pnpm run lint --fix",
    "seed:run:relational": "ts-node -r tsconfig-paths/register ./src/database/seeds/relational/run-seed.ts",
    "seed:run:document": "ts-node -r tsconfig-paths/register ./src/database/seeds/document/run-seed.ts",
    "prebuild": "rimraf dist",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:swc": "nest start -b swc -w",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest --runInBand --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "env-cmd -- jest --config ./test/jest-e2e.json",
    "test:generators:relational": "bash test/generators/run-static.sh relational",
    "test:generators:document": "bash test/generators/run-static.sh document",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "seed": "env-cmd -- ts-node -r tsconfig-paths/register ./src/database/seeds/relational/run-seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1157.0",
    "@aws-sdk/s3-request-presigner": "3.1157.0",
    "@nestjs/common": "11.1.18",
    "@nestjs/config": "4.0.3",
    "@nestjs/core": "11.1.18",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.18",
    "@nestjs/swagger": "11.2.6",
    "@nestjs/typeorm": "11.0.1",
    "@types/multer-s3": "3.0.3",
    "apple-signin-auth": "2.0.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.3.1",
    "google-auth-library": "10.6.2",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "mongoose": "9.4.1",
    "mongoose-autopopulate": "^1.2.1",
    "ms": "2.1.3",
    "multer": "2.1.1",
    "multer-s3": "3.0.1",
    "nestjs-i18n": "10.6.0",
    "nodemailer": "8.0.2",
    "passport": "0.7.0",
    "passport-anonymous": "1.0.1",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "source-map-support": "0.5.21",
    "swagger-ui-express": "5.0.1",
    "typeorm": "0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.1.18",
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.18",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/multer": "2.1.0",
    "@types/node": "25.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-anonymous": "1.0.5",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "env-cmd": "11.0.0",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "^17.4.0",
    "hygen": "6.2.11",
    "jest": "30.3.0",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "@jest/globals": "30.3.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24.3.0 <27"
  }
}
