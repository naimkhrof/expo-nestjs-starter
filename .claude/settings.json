{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm expo:doctor:*)",
      "Bash(pnpm --filter:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git merge --no-ff:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git branch -d:*)",
      "Bash(git push origin main)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./apps/*/.env)",
      "Bash(gh pr create:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "cloudflare",
    "railway",
    "expo"
  ],
  "enabledPlugins": {
    "expo@claude-plugins-official": true,
    "stripe@anthropic-plugin-directory": false
  }
}
